# Rapor yükleme jetonu (GİZLİ, en az 32 karakter). Yerel betik PUT isteğinde Bearer olarak gönderir.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UPLOAD_TOKEN=

# Rapor sayfasını görme şifresi (GİZLİ, en az 12 karakter) ve kullanıcı adı.
VIEW_PASSWORD=
VIEW_USER=admin

# Raporun saklandığı klasör (Docker'da /data, Coolify'da volume bağlayın).
DATA_DIR=./data
PORT=3000
